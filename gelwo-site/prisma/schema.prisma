// Prisma schema for GELWO Phase 2
// Generated by Antigravity AI
// Adjust as needed for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  email      String      @unique
  name       String?
  phone      String?
  address    String?
  leads      Lead[]
  quotations Quotation[]
  invoices   Invoice[]
  projects   Project[]
  documents  Document[]
  userId     String?     @unique
  user       User?       @relation(fields: [userId], references: [id])
}

model Lead {
  id                     String                  @id @default(cuid())
  createdAt              DateTime                @default(now())
  source                 String? // e.g., website, referral
  customerId             String?
  customer               Customer?               @relation(fields: [customerId], references: [id])
  questionnaireResponses QuestionnaireResponse[]
}

model ServiceCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  services Service[]
}

// Section 10: Full Service model matching the blueprint database spec
model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  name             String          @unique
  shortDescription String?
  longDescription  String?
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id])
  icon             String?         // icon name or URL
  heroImage        String?         // hero image URL
  gallery          ServiceGallery[]
  video            String?         // video URL
  features         Json?           // array of feature strings
  benefits         Json?           // array of benefit strings
  process          Json?           // array of process step objects
  pricingType      String?         // e.g. "fixed", "custom", "contact"
  active           Boolean         @default(true)
  featured         Boolean         @default(false)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  pricingRules     PricingRule[]
  formulas         PricingFormula[]
  questionnaire    Questionnaire?
  quotations       Quotation[]
}

model ServiceGallery {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Section 14: Full Product model matching the blueprint database spec
model Product {
  id               String                 @id @default(cuid())
  sku              String?                @unique
  name             String                 @unique
  slug             String                 @unique
  category         String?
  shortDescription String?
  description      String?
  price            Float
  currency         String                 @default("KES")
  pricingType      String?                // e.g. "fixed", "quote", "contact"
  mainImage        String?
  gallery          ProductGallery[]
  videos           Json?                  // array of video URLs
  features         Json?                  // array of feature strings
  specifications   Json?                  // key-value pairs
  availability     String?                @default("available")
  stock            Int                    @default(0)
  featured         Boolean                @default(false)
  active           Boolean                @default(true)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  quotations       QuotationItem[]
  reservations     InventoryReservation[]
}

model ProductGallery {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}



model PricingRule {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  ruleKey   String // e.g., "basePrice", "installationCost"
  value     Float
  formula   String? // optional formula expression
}

model PricingFormula {
  id         String  @id @default(cuid())
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id])
  expression String // e.g., "basePrice * quantity + installationCost"
}

model Questionnaire {
  id         String                  @id @default(cuid())
  serviceId  String                  @unique
  service    Service                 @relation(fields: [serviceId], references: [id])
  schemaJson Json // JSON schema defining steps, fields, validation
  responses  QuestionnaireResponse[]
}

model QuestionnaireResponse {
  id              String        @id @default(cuid())
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id])
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  answersJson     Json // key/value pairs of answers
  quotation       Quotation?
  createdAt       DateTime      @default(now())
}

model Quotation {
  id          String          @id @default(cuid())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  customerId  String?
  customer    Customer?       @relation(fields: [customerId], references: [id])
  serviceId   String
  service     Service         @relation(fields: [serviceId], references: [id])
  status      String          @default("draft") // draft, pendingApproval, approved, rejected
  totalAmount Float           @default(0)
  items       QuotationItem[]

  questionnaireResponseId String?                @unique
  questionnaireResponse   QuestionnaireResponse? @relation(fields: [questionnaireResponseId], references: [id])

  invoice   Invoice?
  documents Document[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  description String?
  quantity    Int       @default(1)
  unitPrice   Float
  totalPrice  Float     @default(0)
}

model Invoice {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  status      String     @default("unpaid") // unpaid, paid, overdue, cancelled
  totalAmount Float      @default(0)
  dueDate     DateTime?
  payments    Payment[]
  documents   Document[]
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Float
  method        String // e.g., "mpesa", "stripe", "bank"
  status        String   @default("pending") // pending, completed, failed
  transactionId String?
  createdAt     DateTime @default(now())
}

model Project {
  id         String      @id @default(cuid())
  name       String
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  status     String      @default("planning") // planning, inProgress, completed, cancelled
  startDate  DateTime?
  endDate    DateTime?
  workOrders WorkOrder[]
  documents  Document[]
}

model WorkOrder {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  type             String // e.g., "inventoryReservation", "staffAssignment"
  status           String            @default("pending") // pending, done, failed
  detailsJson      Json
  staffAssignments StaffAssignment[]
}

model InventoryReservation {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Int
  reservedAt DateTime  @default(now())
  expiresAt  DateTime?
}

model StaffAssignment {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  staffId     String // reference to internal staff user
  role        String // e.g., "technician", "driver"
  assignedAt  DateTime  @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String // could be customerId or staffId
  type        String // e.g., "quotationReady", "paymentReceived"
  payloadJson Json
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}

model Document {
  id   String @id @default(cuid())
  url  String // storage location (S3, Azure Blob, etc.)
  type String // e.g., "quotationPdf", "invoicePdf", "uploadedFile"

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String // e.g., "CREATE_QUOTATION", "APPROVE_INVOICE"
  entity      String // e.g., "Quotation", "Invoice"
  entityId    String // affected entity ID
  userId      String? // user ID or null for system
  user        User?    @relation(fields: [userId], references: [id])
  timestamp   DateTime @default(now())
  detailsJson Json?
}

model SecurityEvent {
  id           String   @id @default(cuid())
  eventType    String
  sourceIp     String?
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  timestamp    DateTime @default(now())
  metadataJson Json?
}

// ---------------------------------------------------
// Core Identity and RBAC Models (Phase 1)
// ---------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  status       String   @default("active") // active, suspended, deleted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer       Customer?
  staffProfile   StaffProfile?
  approvedLeaves LeaveRequest[] @relation("LeaveApprover")
  roles          UserRole[]
  sessions       Session[]
  auditLogs      AuditLog[]
  securityEvents SecurityEvent[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Permission {
  id       String           @id @default(cuid())
  resource String // e.g., "quotations", "customers"
  action   String // e.g., "read", "write", "approve", "full"
  roles    RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------
// HR and Payroll Models
// ---------------------------------------------------

model StaffProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  department      String?
  position        String?
  startDate       DateTime?
  contractType    String?
  salary          Float?
  nssfNumber      String?
  shaNumber       String?
  kraPin          String?
  emergencyContact String?
  leaveBalance    Int            @default(21)
  leaveRequests   LeaveRequest[]
  payrollRecords  PayrollRecord[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model LeaveRequest {
  id             String       @id @default(cuid())
  staffId        String
  staff          StaffProfile @relation(fields: [staffId], references: [id])
  leaveType      String       // Annual, Sick, Family, Study, Other
  startDate      DateTime
  endDate        DateTime
  daysRequested  Int
  reason         String?
  status         String       @default("pending") // pending, approved, rejected
  approvedById   String?
  approvedBy     User?        @relation("LeaveApprover", fields: [approvedById], references: [id])
  createdAt      DateTime     @default(now())
}

model PayrollRecord {
  id             String       @id @default(cuid())
  staffId        String
  staff          StaffProfile @relation(fields: [staffId], references: [id])
  periodMonth    Int
  periodYear     Int
  basicSalary    Float
  allowances     Float        @default(0)
  overtime       Float        @default(0)
  bonuses        Float        @default(0)
  grossPay       Float
  paye           Float        @default(0)
  shaDeduction   Float        @default(0)
  nssfDeduction  Float        @default(0)
  otherDeductions Float       @default(0)
  netPay         Float
  status         String       @default("draft") // draft, approved, paid
  createdAt      DateTime     @default(now())
}

